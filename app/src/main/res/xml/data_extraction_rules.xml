<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. Cache directories, including
     generated CSV exports, are never part of either transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="intent.db" />
        <include domain="database" path="intent.db-wal" />
        <include domain="database" path="intent.db-shm" />
        <include domain="file" path="datastore/intent_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="intent.db" />
        <include domain="database" path="intent.db-wal" />
        <include domain="database" path="intent.db-shm" />
        <include domain="file" path="datastore/intent_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
